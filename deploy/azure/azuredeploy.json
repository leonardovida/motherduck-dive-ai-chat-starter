{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "1641861415273416569"
    }
  },
  "functions": [
    {
      "namespace": "__bicep",
      "members": {
        "vaultSecretName": {
          "parameters": [
            {
              "type": "string",
              "name": "setting"
            }
          ],
          "output": {
            "type": "string",
            "value": "[toLower(replace(parameters('setting'), '_', '-'))]"
          }
        }
      }
    }
  ],
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "dive-chat",
      "minLength": 2,
      "maxLength": 24,
      "metadata": {
        "description": "Name for the container app; the jobs and other resources are named after it. Lowercase letters, digits and hyphens."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region for every resource. Defaults to the resource group's region."
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "ghcr.io/leonardovida/motherduck-dive-ai-chat-starter:latest",
      "metadata": {
        "description": "Container image. Use a release tag, such as ghcr.io/<owner>/<repo>:0.6.0, to control upgrades."
      }
    },
    "signInMode": {
      "type": "string",
      "defaultValue": "accounts",
      "allowedValues": [
        "accounts",
        "password"
      ],
      "metadata": {
        "description": "accounts: per-person sign-in (MOTHERDUCK_APP_TOKEN). password: one shared password (DEMO_PASSWORD), which also needs trustedIpHeader. See docs/deploy.md."
      }
    },
    "signInSecret": {
      "type": "securestring",
      "metadata": {
        "description": "MOTHERDUCK_APP_TOKEN in accounts mode, or DEMO_PASSWORD in password mode. Stored in Key Vault."
      }
    },
    "motherduckEmbedToken": {
      "type": "securestring",
      "metadata": {
        "description": "MOTHERDUCK_EMBED_TOKEN: a MotherDuck token allowed to create embed sessions. Stored in Key Vault."
      }
    },
    "motherduckChatToken": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "MOTHERDUCK_CHAT_TOKEN: a read-only MotherDuck token for chat. Leave empty to show the Dive without chat. Stored in Key Vault."
      }
    },
    "modelApiKeySetting": {
      "type": "string",
      "defaultValue": "OPENAI_API_KEY",
      "allowedValues": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "OPENROUTER_API_KEY",
        "AZURE_API_KEY",
        "AWS_BEARER_TOKEN_BEDROCK",
        "GOOGLE_VERTEX_API_KEY",
        "OPENAI_COMPATIBLE_API_KEY"
      ],
      "metadata": {
        "description": "The setting name of your model provider key."
      }
    },
    "modelApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "The model provider key. Leave empty to show the Dive without chat. Stored in Key Vault."
      }
    },
    "motherduckEmbedUsername": {
      "type": "string",
      "metadata": {
        "description": "MOTHERDUCK_EMBED_USERNAME: the read-only service account the embedded Dive runs as."
      }
    },
    "diveOverviewId": {
      "type": "string",
      "metadata": {
        "description": "DIVE_OVERVIEW_ID: the ID of the saved Dive to show."
      }
    },
    "diveOverviewChatDatabase": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "DIVE_OVERVIEW_CHAT_DATABASE: the database chat may query."
      }
    },
    "appTitle": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "APP_TITLE: the name shown in the header. Optional."
      }
    },
    "settings": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Other plain settings as a JSON object, for example {\"CHAT_PROVIDER\": \"azure\", \"AZURE_RESOURCE_NAME\": \"my-resource\"}. Add \"APP_URL\" here when the app has its own domain."
      }
    },
    "extraSecrets": {
      "type": "secureObject",
      "defaultValue": {},
      "metadata": {
        "description": "Other secret settings as a JSON object, for example {\"SSO_CLIENT_SECRET\": \"...\"}. Names use letters, digits and underscores. Stored in Key Vault."
      }
    },
    "trustedIpHeader": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Leave empty. Set it only when a proxy you control overwrites this header with the visitor's IP address on every request, and Allowed Ip Ranges admits only that proxy. Password sign-in needs it. See docs/deploy.md."
      }
    },
    "allowedIpRanges": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Leave empty to accept requests from anywhere. Otherwise only these IPv4 ranges in CIDR notation, for example [\"203.0.113.10/32\"], can reach the app's own address. See docs/deploy.md."
      }
    },
    "sessionSecret": {
      "type": "securestring",
      "defaultValue": "[format('{0}{1}', newGuid(), newGuid())]",
      "minLength": 32,
      "metadata": {
        "description": "SESSION_SECRET, which signs sign-in sessions. Leave the generated value. Stored in Key Vault."
      }
    },
    "cronSecret": {
      "type": "securestring",
      "defaultValue": "[newGuid()]",
      "minLength": 16,
      "metadata": {
        "description": "CRON_SECRET for the scheduled jobs. Leave the generated value. Stored in Key Vault."
      }
    },
    "keepGeneratedSecrets": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "false on the first deployment. Set it to true when deploying again: Key Vault then keeps its SESSION_SECRET and CRON_SECRET, the two fields above are ignored, and nobody is signed out."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "metadata": {
        "description": "Replicas kept running. 0 scales to zero when idle; the first request then takes a few seconds."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 1,
      "metadata": {
        "description": "The most replicas. Sign-in limits are kept per replica."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "secretRefs",
        "count": "[length(variables('secretSettings'))]",
        "input": {
          "name": "[__bicep.vaultSecretName(variables('secretSettings')[copyIndex('secretRefs')])]",
          "keyVaultUrl": "[format('{0}/secrets/{1}', variables('vaultUri'), __bicep.vaultSecretName(variables('secretSettings')[copyIndex('secretRefs')]))]",
          "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName')))]"
        }
      }
    ],
    "suffix": "[uniqueString(resourceGroup().id, parameters('appName'))]",
    "signInSetting": "[if(equals(parameters('signInMode'), 'accounts'), 'MOTHERDUCK_APP_TOKEN', 'DEMO_PASSWORD')]",
    "secretValues": "[union(parameters('extraSecrets'), if(parameters('keepGeneratedSecrets'), createObject(), createObject('SESSION_SECRET', parameters('sessionSecret'), 'CRON_SECRET', parameters('cronSecret'))), createObject(format('{0}', variables('signInSetting')), parameters('signInSecret'), 'MOTHERDUCK_EMBED_TOKEN', parameters('motherduckEmbedToken')), if(empty(parameters('motherduckChatToken')), createObject(), createObject('MOTHERDUCK_CHAT_TOKEN', parameters('motherduckChatToken'))), if(empty(parameters('modelApiKey')), createObject(), createObject(format('{0}', parameters('modelApiKeySetting')), parameters('modelApiKey'))))]",
    "secretSettings": "[union(createArray('SESSION_SECRET', 'CRON_SECRET'), objectKeys(variables('secretValues')))]",
    "namedSettings": "[filter(items(createObject('MOTHERDUCK_EMBED_USERNAME', parameters('motherduckEmbedUsername'), 'DIVE_OVERVIEW_ID', parameters('diveOverviewId'), 'DIVE_OVERVIEW_CHAT_DATABASE', parameters('diveOverviewChatDatabase'), 'APP_TITLE', parameters('appTitle'), 'AUTH_TRUSTED_IP_HEADER', parameters('trustedIpHeader'))), lambda('entry', not(empty(lambdaVariables('entry').value))))]",
    "plainSettings": "[union(parameters('settings'), toObject(variables('namedSettings'), lambda('entry', lambdaVariables('entry').key), lambda('entry', lambdaVariables('entry').value)))]",
    "plainEnv": "[map(filter(items(variables('plainSettings')), lambda('entry', and(not(equals(lambdaVariables('entry').key, 'APP_URL')), not(contains(variables('secretSettings'), lambdaVariables('entry').key))))), lambda('entry', createObject('name', lambdaVariables('entry').key, 'value', string(lambdaVariables('entry').value))))]",
    "keyVaultSecretsUser": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
    "vaultUri": "[format('https://{0}{1}', format('kv-{0}', variables('suffix')), environment().suffixes.keyvaultDns)]",
    "cronSecretRef": "[filter(variables('secretRefs'), lambda('ref', equals(lambdaVariables('ref').name, 'cron-secret')))]",
    "cronJobs": [
      {
        "name": "daily",
        "route": "/api/cron/daily",
        "cron": "17 4 * * *"
      },
      {
        "name": "digest",
        "route": "/api/cron/digest",
        "cron": "0 8 * * 1"
      }
    ]
  },
  "resources": {
    "identity": {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-identity', parameters('appName'))]",
      "location": "[parameters('location')]"
    },
    "vault": {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[format('kv-{0}', variables('suffix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7
      }
    },
    "vaultSecrets": {
      "copy": {
        "name": "vaultSecrets",
        "count": "[length(items(variables('secretValues')))]"
      },
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', format('kv-{0}', variables('suffix')), __bicep.vaultSecretName(items(variables('secretValues'))[copyIndex()].key))]",
      "properties": {
        "value": "[items(variables('secretValues'))[copyIndex()].value]"
      },
      "dependsOn": [
        "vault"
      ]
    },
    "readSecrets": {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix')))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))), variables('keyVaultSecretsUser'))]",
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsUser')]",
        "principalId": "[reference('identity').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "identity",
        "vault"
      ]
    },
    "logs": {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs', parameters('appName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    "environment": {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}-env', parameters('appName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference('logs').customerId]",
            "sharedKey": "[listKeys('logs', '2023-09-01').primarySharedKey]"
          }
        },
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ]
      },
      "dependsOn": [
        "logs",
        "readSecrets"
      ]
    },
    "app": {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('appName')))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "ingress": {
            "copy": [
              {
                "name": "ipSecurityRestrictions",
                "count": "[length(parameters('allowedIpRanges'))]",
                "input": {
                  "name": "[format('allow-{0}', copyIndex('ipSecurityRestrictions'))]",
                  "ipAddressRange": "[parameters('allowedIpRanges')[copyIndex('ipSecurityRestrictions')]]",
                  "action": "Allow"
                }
              }
            ],
            "external": true,
            "targetPort": 3000,
            "transport": "auto",
            "allowInsecure": false
          },
          "secrets": "[variables('secretRefs')]"
        },
        "template": {
          "containers": [
            {
              "name": "app",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": "[concat(variables('plainEnv'), createArray(createObject('name', 'APP_URL', 'value', coalesce(tryGet(parameters('settings'), 'APP_URL'), format('https://{0}.{1}', parameters('appName'), reference('environment').defaultDomain)))), map(variables('secretSettings'), lambda('setting', createObject('name', lambdaVariables('setting'), 'secretRef', __bicep.vaultSecretName(lambdaVariables('setting'))))))]",
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/api/auth",
                    "port": 3000
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 30
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/api/auth",
                    "port": 3000
                  },
                  "periodSeconds": 30
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]"
          }
        }
      },
      "dependsOn": [
        "environment",
        "identity",
        "readSecrets",
        "vault",
        "vaultSecrets"
      ]
    },
    "jobs": {
      "copy": {
        "name": "jobs",
        "count": "[length(variables('cronJobs'))]"
      },
      "type": "Microsoft.App/jobs",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}-{1}', parameters('appName'), variables('cronJobs')[copyIndex()].name)]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('appName')))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "triggerType": "Schedule",
          "scheduleTriggerConfig": {
            "cronExpression": "[variables('cronJobs')[copyIndex()].cron]",
            "parallelism": 1,
            "replicaCompletionCount": 1
          },
          "replicaTimeout": 900,
          "replicaRetryLimit": 1,
          "secrets": "[variables('cronSecretRef')]"
        },
        "template": {
          "containers": [
            {
              "name": "cron",
              "image": "[parameters('image')]",
              "command": [
                "node",
                "deploy/cron.mjs",
                "[variables('cronJobs')[copyIndex()].route]"
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
                {
                  "name": "APP_URL",
                  "value": "[coalesce(tryGet(parameters('settings'), 'APP_URL'), format('https://{0}.{1}', parameters('appName'), reference('environment').defaultDomain))]"
                },
                {
                  "name": "CRON_SECRET",
                  "secretRef": "cron-secret"
                }
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "environment",
        "identity",
        "readSecrets",
        "vault",
        "vaultSecrets"
      ]
    }
  },
  "outputs": {
    "appUrl": {
      "type": "string",
      "metadata": {
        "description": "The app address, which APP_URL is set to."
      },
      "value": "[coalesce(tryGet(parameters('settings'), 'APP_URL'), format('https://{0}.{1}', parameters('appName'), reference('environment').defaultDomain))]"
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "The Key Vault that holds the secrets."
      },
      "value": "[format('kv-{0}', variables('suffix'))]"
    }
  }
}