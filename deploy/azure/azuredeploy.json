{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "18286160838102532207"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "dive-chat",
      "minLength": 2,
      "maxLength": 24,
      "metadata": {
        "description": "Name for the container app; the jobs and other resources are named after it. Lowercase letters, digits and hyphens."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region for every resource. Defaults to the resource group's region."
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "ghcr.io/leonardovida/motherduck-dive-ai-chat-starter:latest",
      "metadata": {
        "description": "Container image. Use a release tag, such as ghcr.io/<owner>/<repo>:0.6.0, to control upgrades."
      }
    },
    "signInMode": {
      "type": "string",
      "defaultValue": "accounts",
      "allowedValues": [
        "accounts",
        "password"
      ],
      "metadata": {
        "description": "accounts: per-person sign-in (MOTHERDUCK_APP_TOKEN). password: one shared password (DEMO_PASSWORD), which also needs trustedIpHeader. See docs/deploy.md."
      }
    },
    "signInSecret": {
      "type": "securestring",
      "metadata": {
        "description": "MOTHERDUCK_APP_TOKEN in accounts mode, or DEMO_PASSWORD in password mode. Stored in Key Vault."
      }
    },
    "motherduckEmbedToken": {
      "type": "securestring",
      "metadata": {
        "description": "MOTHERDUCK_EMBED_TOKEN: a MotherDuck token allowed to create embed sessions. Stored in Key Vault."
      }
    },
    "motherduckChatToken": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "MOTHERDUCK_CHAT_TOKEN: a read-only MotherDuck token for chat. Leave empty to show the Dive without chat. Stored in Key Vault."
      }
    },
    "modelApiKeySetting": {
      "type": "string",
      "defaultValue": "OPENAI_API_KEY",
      "allowedValues": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "OPENROUTER_API_KEY",
        "AZURE_API_KEY",
        "AWS_BEARER_TOKEN_BEDROCK",
        "GOOGLE_VERTEX_API_KEY",
        "OPENAI_COMPATIBLE_API_KEY"
      ],
      "metadata": {
        "description": "The setting name of your model provider key."
      }
    },
    "modelApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "The model provider key. Leave empty to show the Dive without chat. Stored in Key Vault."
      }
    },
    "motherduckEmbedUsername": {
      "type": "string",
      "metadata": {
        "description": "MOTHERDUCK_EMBED_USERNAME: the read-only service account the embedded Dive runs as."
      }
    },
    "diveOverviewId": {
      "type": "string",
      "metadata": {
        "description": "DIVE_OVERVIEW_ID: the ID of the saved Dive to show."
      }
    },
    "diveOverviewChatDatabase": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "DIVE_OVERVIEW_CHAT_DATABASE: the database chat may query."
      }
    },
    "appTitle": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "APP_TITLE: the name shown in the header. Optional."
      }
    },
    "settings": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Other plain settings as a JSON object, for example {\"CHAT_PROVIDER\": \"azure\", \"AZURE_RESOURCE_NAME\": \"my-resource\"}."
      }
    },
    "extraSecrets": {
      "type": "secureObject",
      "defaultValue": {},
      "metadata": {
        "description": "Other secret settings as a JSON object, for example {\"SSO_CLIENT_SECRET\": \"...\"}. Stored in Key Vault."
      }
    },
    "trustedIpHeader": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Leave empty unless a proxy you control sits in front of the app, overwrites this header with the client IP and is the only way in. Password sign-in needs it. See docs/deploy.md."
      }
    },
    "sessionSecret": {
      "type": "securestring",
      "defaultValue": "[format('{0}{1}', newGuid(), newGuid())]",
      "metadata": {
        "description": "SESSION_SECRET. Leave the generated value."
      }
    },
    "cronSecret": {
      "type": "securestring",
      "defaultValue": "[newGuid()]",
      "metadata": {
        "description": "CRON_SECRET for the scheduled jobs. Leave the generated value."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "metadata": {
        "description": "Replicas kept running. 0 scales to zero when idle; the first request then takes a few seconds."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 1,
      "metadata": {
        "description": "The most replicas. Sign-in limits are kept per replica."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "allSecrets",
        "count": "[length(concat(variables('baseSecrets'), map(items(parameters('extraSecrets')), lambda('entry', createObject('setting', lambdaVariables('entry').key, 'value', lambdaVariables('entry').value)))))]",
        "input": {
          "setting": "[concat(variables('baseSecrets'), map(items(parameters('extraSecrets')), lambda('entry', createObject('setting', lambdaVariables('entry').key, 'value', lambdaVariables('entry').value))))[copyIndex('allSecrets')].setting]",
          "value": "[concat(variables('baseSecrets'), map(items(parameters('extraSecrets')), lambda('entry', createObject('setting', lambdaVariables('entry').key, 'value', lambdaVariables('entry').value))))[copyIndex('allSecrets')].value]",
          "name": "[toLower(replace(concat(variables('baseSecrets'), map(items(parameters('extraSecrets')), lambda('entry', createObject('setting', lambdaVariables('entry').key, 'value', lambdaVariables('entry').value))))[copyIndex('allSecrets')].setting, '_', '-'))]"
        }
      },
      {
        "name": "secretRefs",
        "count": "[length(variables('allSecrets'))]",
        "input": {
          "name": "[variables('allSecrets')[copyIndex('secretRefs')].name]",
          "keyVaultUrl": "[format('{0}/secrets/{1}', variables('vaultUri'), variables('allSecrets')[copyIndex('secretRefs')].name)]",
          "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName')))]"
        }
      }
    ],
    "suffix": "[uniqueString(resourceGroup().id, parameters('appName'))]",
    "signInSetting": "[if(equals(parameters('signInMode'), 'accounts'), 'MOTHERDUCK_APP_TOKEN', 'DEMO_PASSWORD')]",
    "baseSecrets": "[concat(createArray(createObject('setting', 'SESSION_SECRET', 'value', parameters('sessionSecret')), createObject('setting', 'CRON_SECRET', 'value', parameters('cronSecret')), createObject('setting', variables('signInSetting'), 'value', parameters('signInSecret')), createObject('setting', 'MOTHERDUCK_EMBED_TOKEN', 'value', parameters('motherduckEmbedToken'))), if(empty(parameters('motherduckChatToken')), createArray(), createArray(createObject('setting', 'MOTHERDUCK_CHAT_TOKEN', 'value', parameters('motherduckChatToken')))), if(empty(parameters('modelApiKey')), createArray(), createArray(createObject('setting', parameters('modelApiKeySetting'), 'value', parameters('modelApiKey')))))]",
    "plainSettings": "[union(parameters('settings'), createObject('MOTHERDUCK_EMBED_USERNAME', parameters('motherduckEmbedUsername'), 'DIVE_OVERVIEW_ID', parameters('diveOverviewId'), 'DIVE_OVERVIEW_CHAT_DATABASE', parameters('diveOverviewChatDatabase'), 'APP_TITLE', parameters('appTitle')), if(empty(parameters('trustedIpHeader')), createObject(), createObject('AUTH_TRUSTED_IP_HEADER', parameters('trustedIpHeader'))))]",
    "keyVaultSecretsUser": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
    "vaultUri": "[format('https://{0}{1}', format('kv-{0}', variables('suffix')), environment().suffixes.keyvaultDns)]",
    "cronSecretRef": "[filter(variables('secretRefs'), lambda('ref', equals(lambdaVariables('ref').name, 'cron-secret')))]",
    "cronJobs": [
      {
        "name": "daily",
        "route": "/api/cron/daily",
        "cron": "17 4 * * *"
      },
      {
        "name": "digest",
        "route": "/api/cron/digest",
        "cron": "0 8 * * 1"
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-identity', parameters('appName'))]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[format('kv-{0}', variables('suffix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7
      }
    },
    {
      "copy": {
        "name": "vaultSecrets",
        "count": "[length(variables('allSecrets'))]"
      },
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', format('kv-{0}', variables('suffix')), variables('allSecrets')[copyIndex()].name)]",
      "properties": {
        "value": "[variables('allSecrets')[copyIndex()].value]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix')))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))), variables('keyVaultSecretsUser'))]",
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsUser')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName')))]",
        "[resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix')))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}-logs', parameters('appName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}-env', parameters('appName'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('appName'))), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('appName'))), '2023-09-01').primarySharedKey]"
          }
        },
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('appName')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('appName')))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 3000,
            "transport": "auto",
            "allowInsecure": false
          },
          "secrets": "[variables('secretRefs')]"
        },
        "template": {
          "containers": [
            {
              "name": "app",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": "[concat(map(items(variables('plainSettings')), lambda('entry', createObject('name', lambdaVariables('entry').key, 'value', string(lambdaVariables('entry').value)))), createArray(createObject('name', 'APP_URL', 'value', format('https://{0}.{1}', parameters('appName'), reference(resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('appName'))), '2025-01-01').defaultDomain))), map(variables('allSecrets'), lambda('item', createObject('name', lambdaVariables('item').setting, 'secretRef', lambdaVariables('item').name))))]",
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/api/auth",
                    "port": 3000
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 30
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/api/auth",
                    "port": 3000
                  },
                  "periodSeconds": 30
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('appName')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName')))]",
        "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix'))), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))), variables('keyVaultSecretsUser')))]",
        "[resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix')))]",
        "vaultSecrets"
      ]
    },
    {
      "copy": {
        "name": "jobs",
        "count": "[length(variables('cronJobs'))]"
      },
      "type": "Microsoft.App/jobs",
      "apiVersion": "2025-01-01",
      "name": "[format('{0}-{1}', parameters('appName'), variables('cronJobs')[copyIndex()].name)]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('appName')))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "triggerType": "Schedule",
          "scheduleTriggerConfig": {
            "cronExpression": "[variables('cronJobs')[copyIndex()].cron]",
            "parallelism": 1,
            "replicaCompletionCount": 1
          },
          "replicaTimeout": 600,
          "replicaRetryLimit": 1,
          "secrets": "[variables('cronSecretRef')]"
        },
        "template": {
          "containers": [
            {
              "name": "cron",
              "image": "[parameters('image')]",
              "command": [
                "node",
                "deploy/cron.mjs",
                "[variables('cronJobs')[copyIndex()].route]"
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
                {
                  "name": "APP_URL",
                  "value": "[format('https://{0}.{1}', parameters('appName'), reference(resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('appName'))), '2025-01-01').defaultDomain)]"
                },
                {
                  "name": "CRON_SECRET",
                  "secretRef": "cron-secret"
                }
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('appName')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName')))]",
        "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix'))), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix'))), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('appName'))), variables('keyVaultSecretsUser')))]",
        "[resourceId('Microsoft.KeyVault/vaults', format('kv-{0}', variables('suffix')))]",
        "vaultSecrets"
      ]
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "metadata": {
        "description": "The app address. APP_URL is already set to it."
      },
      "value": "[format('https://{0}.{1}', parameters('appName'), reference(resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('appName'))), '2025-01-01').defaultDomain)]"
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "The Key Vault that holds the secrets."
      },
      "value": "[format('kv-{0}', variables('suffix'))]"
    }
  }
}