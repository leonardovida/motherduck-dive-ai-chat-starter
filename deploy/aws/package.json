{
  "name": "motherduck-dive-ai-chat-aws",
  "private": true,
  "type": "module",
  "description": "AWS CDK app that runs the container image on ECS Fargate behind CloudFront. See docs/deploy.md.",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "cdk": "cdk",
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth --quiet",
    "template": "node scripts/write-template.ts",
    "check:template": "node scripts/write-template.ts --check"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "aws-cdk": "2.1147.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0"
}
