{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 8 * * 1"
    }
  ]
}
