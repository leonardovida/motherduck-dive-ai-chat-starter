# Variable names only. Inject real values through your runtime secret manager or a local
# .env.local that is never committed. See README.md for what each one holds.
# Agent setup: read AGENTS.md and docs/agent-setup.md. Supply credentials in one runtime
# secret manager; let the agent discover the Dive ID, username, database alias and region.
# Check missing names without values: npm run --silent setup -- --json
# GitHub Actions secrets do not configure this application's runtime.

# Sign-in. Without DEMO_PASSWORD, local development accepts "duckdemo"; production refuses
# every sign-in until DEMO_PASSWORD and a SESSION_SECRET of 32+ characters are set.
DEMO_PASSWORD=
SESSION_SECRET=
# Production: Vercel selects its overwritten x-forwarded-for header automatically.
# Other hosts must name a single-IP header their trusted proxy always overwrites.
# Local development defaults to a shared login-failure limit.
# AUTH_TRUSTED_IP_HEADER=x-real-ip
# Optional header and browser title.
APP_TITLE=Dive workspace

# Embedding. One token creates embed sessions for every Dive; each Dive runs as a
# read-only service account (MOTHERDUCK_EMBED_USERNAME unless dives.config.mjs sets usernameEnv).
MOTHERDUCK_EMBED_TOKEN=
MOTHERDUCK_EMBED_USERNAME=

# One block per Dive in dives.config.mjs.
DIVE_OVERVIEW_ID=
DIVE_OVERVIEW_VERSION=
# The starter Overview Dive has no data dependency. Add resources in dives.config.mjs for your own Dive.
DIVE_OVERVIEW_CHAT_DATABASE=
DIVE_EXPLORER_ID=
DIVE_EXPLORER_VERSION=
DIVE_EXPLORER_SHARE_URL=
DIVE_EXPLORER_CHAT_DATABASE=

# Chat (optional). Without a provider key the panel says chat isn't configured.
# Set OpenAI, Anthropic or both. See docs/model-routing.md.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional provider for tiers without an override: openai or anthropic.
# CHAT_PROVIDER=anthropic
# Optional per-tier model, as provider:model-id. Defaults: gpt-6-luna / gpt-6.1-sol / gpt-6-astra
# with OpenAI, claude-haiku-5-5 / claude-sonnet-5-5 / claude-opus-5-5 with Anthropic.
# CHAT_MODEL_LUNA=anthropic:claude-haiku-5-5
# CHAT_MODEL_SOL=
# CHAT_MODEL_ASTRA=
# Default picker choice: auto (routes each question), luna, sol or astra.
CHAT_DEFAULT_MODEL=auto
# Optional comma-separated tiers shown in the picker. Omit for all three. CHAT_ROUTER=off removes Auto.
# CHAT_MODELS=luna,sol,astra
# CHAT_ROUTER=off
# Optional compatible endpoints or routers, including /v1. Used by chat and setup checks.
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Read-only MotherDuck token the assistant queries with, scoped to the chat databases.
MOTHERDUCK_CHAT_TOKEN=
# Optional Postgres endpoint host for your MotherDuck region.
MOTHERDUCK_PG_HOST=pg.us-east-1-aws.motherduck.com

# Optional additional model request for suggested questions; off by default.
CHAT_FOLLOW_UPS=false

# Accounts, admin portal and single sign-on (optional). See docs/accounts.md.
# Setting MOTHERDUCK_APP_TOKEN replaces DEMO_PASSWORD with per-person accounts.
# It is a read-write token for the app's own database only, never the chat token.
# MOTHERDUCK_APP_TOKEN=
# APP_DATABASE=dive_chat_app
# Public address, for SSO redirects. Detected automatically on Vercel production.
# APP_URL=https://dives.example.com
# Saved conversations: on by default in accounts mode.
# CHAT_HISTORY=off
# CHAT_RETENTION_DAYS=90
# A public look-around demo: every screen opens, but nothing can be changed.
# PUBLIC_DEMO=true
# Any OpenID Connect provider (Okta, Entra ID, Google Workspace, Auth0, Keycloak...).
# Redirect URI to register: <APP_URL>/api/account/callback/<SSO_PROVIDER_ID or sso>
# SSO_ISSUER=
# SSO_DISCOVERY_URL=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_LABEL=Single sign-on
# SSO_PROVIDER_ID=sso
# Ready-made providers.
# OKTA_ISSUER=
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Let SSO create accounts for these email domains. Without it, an admin adds people first.
# AUTH_ALLOWED_EMAIL_DOMAINS=example.com
