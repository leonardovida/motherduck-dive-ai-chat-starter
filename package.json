{
  "name": "motherduck-dive-ai-chat-starter",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "next build",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "dev": "next dev",
    "start": "next start",
    "check:setup": "node scripts/check-setup.mjs",
    "setup": "node scripts/check-setup.mjs --require-chat",
    "release:check": "node scripts/check-release.mjs",
    "db:migrate": "node scripts/app-db.mjs migrate",
    "admin:create": "node scripts/app-db.mjs create-admin"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.135",
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/azure": "4.0.119",
    "@ai-sdk/google-vertex": "5.0.134",
    "@ai-sdk/openai": "4.0.111",
    "@ai-sdk/openai-compatible": "3.0.87",
    "@ai-sdk/react": "4.0.170",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "ai": "7.0.166",
    "better-auth": "1.7.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "google-auth-library": "11.3.4",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.21.0",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.7"
  },
  "description": "Embed MotherDuck Dives with a streaming AI SQL assistant. A configurable Next.js starter.",
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "tailwindcss": "4.3.5"
  },
  "license": "Apache-2.0"
}
