{
  "name": "motherduck-dive-ai-chat-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "next build",
    "test": "node --test test/*.test.mjs",
    "dev": "next dev",
    "start": "next start",
    "smoke:openai": "node scripts/smoke-openai.mjs",
    "check:setup": "node scripts/check-setup.mjs",
    "setup": "node scripts/check-setup.mjs --require-chat",
    "release:check": "node scripts/check-release.mjs",
    "db:migrate": "node scripts/app-db.mjs migrate",
    "admin:create": "node scripts/app-db.mjs create-admin"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.93",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/react": "4.0.162",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "ai": "7.0.158",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.2",
    "streamdown": "2.7.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.7"
  },
  "description": "Embed MotherDuck Dives with a streaming AI SQL assistant. A configurable Next.js starter.",
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "license": "Apache-2.0"
}
